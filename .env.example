# hermes gateway LLM 설정 (agent/skills/hermes_api.py)
#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env
#
# hermes 질의 스킬 on/off (기본 동작은 아래 HERMES_ENABLED 참고).
# 꺼지면 hermes API 를 호출하는 코드가 실행되지 않고,
# 기존 에코 폴백("인지된 음성은 ... 입니다")이 동작합니다.
# hermes 를 쓰지 않는 개발환경(dev)에서는 .env 를 만들지 않으면 됩니다.

# hermes 스킬 on/off 스위치.
#   1/true/yes/on  → 켜짐 (아래 HERMES_API_KEY 도 채워야 함)
#   0/false/no/off → 꺼짐 (hermes 호출 안 함, 에코 폴백 동작)
#   미설정         → 하위호환: HERMES_API_KEY 가 있으면 켜진 것으로 간주
HERMES_ENABLED=1

# hermes gateway 주소 (기본값: http://127.0.0.1:8642/v1)
HERMES_BASE_URL=http://127.0.0.1:8642/v1

# API 키. hermes 는 인증을 요구하지 않지만 OpenAI SDK 가 필수로 요구한다.
# 이 값이 있어야 스킬이 활성화되므로 더미 값이라도 채워야 한다.
HERMES_API_KEY=

# 모델 이름 (기본값: qwen3:8b)
HERMES_MODEL=qwen3:8b

# 응답 대기 제한 시간(초) (기본값: 30)
HERMES_TIMEOUT=30


# ==========================================
# Claude Code CLI 질의 설정 (agent/skills/claude_p.py)
# ==========================================
# 로컬에 설치된 `claude` 명령을 `--print` 모드로 실행해 질문에 답하는 스킬입니다.
# 웹 검색(WebSearch/WebFetch)을 쓸 수 있어 hermes(로컬 LLM)보다 답변 범위가 넓지만,
# 클라우드 호출이라 완전 오프라인은 아닙니다.

# claude CLI 스킬 on/off 스위치.
#   1/true/yes/on  → 켜짐 (hermes 보다 먼저 시도됨)
#   그 외/미설정   → 꺼짐 (hermes 또는 에코 폴백이 동작)
CLAUDE_CLI_ENABLED=0

# 사용할 모델. 비우면 claude CLI 설정값을 따른다.
# 전체 이름(claude-opus-5, claude-sonnet-5, claude-haiku-4-5, claude-fable-5)을
# 권장한다. 별칭(opus/sonnet/haiku/fable)을 적어도 되지만, 별칭은 "그 계열의 최신
# 모델"이라는 뜻이라 CLI 버전이 올라가면 가리키는 모델이 조용히 바뀐다. 그래서
# 스킬이 아는 별칭은 실행 시 전체 이름으로 펴서 넘긴다(모르는 값은 그대로 통과).
CLAUDE_CLI_MODEL=claude-sonnet-5

# 생각 깊이(--effort): low / medium / high / xhigh / max.
# 낮을수록 빠르고 싸며, 높을수록 오래 생각한다. 음성 응답은 지연이 바로 체감되므로
# low~medium 이 무난하다. 비우면 옵션을 넘기지 않고 claude CLI 기본값을 따른다.
# 인식할 수 없는 값은 경고 후 무시한다(= 옵션 생략).
CLAUDE_CLI_EFFORT=medium

# 응답 대기 제한 시간(초) (기본값: 60). 초과하면 안내 문구를 읽어준다.
CLAUDE_CLI_TIMEOUT=60

# 허용할 도구 목록 (기본값: WebSearch,WebFetch).
# 여기 적힌 도구만 권한이 허용된다. 목록에서 빠진 도구를 모델이 호출하면
# 런타임에 거부되고 "권한이 없어서 확인하지 못했습니다" 류의 답이 돌아온다.
# 비워두면 --tools "" 로 도구 목록 자체를 비워, 거부 없이 모델 지식만으로 답한다.
CLAUDE_CLI_ALLOWED_TOOLS=WebSearch,WebFetch


# ==========================================
# 오디오 장치 선택 (agent/config.py)
# ==========================================
# USB 장치의 PyAudio 인덱스는 재연결/부팅 순서에 따라 바뀌므로 인덱스 대신
# 장치 "이름"으로 찾는다. 아래 값은 이름의 접두사(prefix) 패턴(대소문자 무시)이며,
# 비워두면 ENVIRONMENTS 프리셋의 기본 패턴(prod = "USB")을 사용한다.
# 완전일치가 아니므로 부팅마다 바뀌는 끝의 "(hw:N,M)" 번호는 빼고 적어도 되고,
# 붙여 적어도 무시하고 매칭한다. 접두사로 일치하는 장치가 없으면 부분일치로 폴백한다.
#
# 실제 장치 이름 확인:
#   python main_agent.py --list-devices
# 예: 목록이 "USB PnP Sound Device: Audio (hw:2,0)" 이면
#     AUDIO_INPUT_NAME=USB PnP Sound Device

AUDIO_INPUT_NAME=
AUDIO_OUTPUT_NAME=


# ==========================================
# 끼어들기 / barge-in (agent/bargein.py)
# ==========================================
# LLM 이 답을 만드는 동안(대기음 구간)과 답변을 읽어주는 동안 "알렉사"를 감시해,
# 부르면 진행 중이던 질의·재생을 즉시 중단하고 곧바로 다음 명령을 받는다.
# 엉뚱한 답변을 끝까지 듣거나 느린 검색을 마냥 기다리지 않아도 되게 하는 기능이다.
#   1/true/yes/on  → 켜짐 (기본값)
#   0/false/no/off → 꺼짐 (끝날 때까지 기다린다 = 기존 동작)
BARGE_IN_ENABLED=1

# 끼어들기 호출어 임계값 (기본값 0.7, 대기 상태는 0.5).
# 재생 중에는 스피커 소리가 마이크로 되돌아오므로(에코 제거 없음) 대기 상태보다 높게
# 잡아 자기 답변 소리에 스스로 깨는 것을 막는다. 마이크/스피커가 가까워 혼자 깨어나면
# 올리고(0.8~0.9), 불러도 잘 안 끊기면 낮춘다(0.6).
BARGE_IN_THRESHOLD=0.7
