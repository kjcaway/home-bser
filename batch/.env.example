# ==========================================
# 배치 잡 전용 설정 (batch/*.py)
# ==========================================
# batch/.env 로 복사한 뒤 값을 채우세요 (git 에 올라가지 않습니다).
#   cp batch/.env.example batch/.env
#
# 루트 .env 와 **완전히 별개**입니다 — 배치는 이 파일만 읽습니다.
# 실제 환경변수가 항상 우선이므로 일회성 덮어쓰기도 됩니다:
#   CLAUDE_CLI_EFFORT=low ./batch/run.sh


# ==========================================
# Claude Code CLI (요약 백엔드)
# ==========================================
# 꺼져 있으면 잡이 아무것도 하지 않고 종료 코드 1 로 끝납니다 (hermes 폴백 없음).
#   1/true/yes/on → 켜짐, 그 외/미설정 → 꺼짐
CLAUDE_CLI_ENABLED=1

# 사용할 모델. 전체 이름 권장(claude-opus-5, claude-sonnet-5, claude-haiku-4-5,
# claude-fable-5). 별칭(opus/sonnet/haiku/fable)은 실행 시 전체 이름으로 펴집니다.
# 비우면 CLI 기본값.
CLAUDE_CLI_MODEL=claude-sonnet-5

# 생각 깊이: low / medium / high / xhigh / max. 배치는 지연이 체감되지 않습니다.
CLAUDE_CLI_EFFORT=high

# 요약 하나당 제한 시간(초). 기본 300 — 웹 검색을 여러 번 도는 것이 정상입니다.
CLAUDE_CLI_TIMEOUT=300

# 허용할 도구. 웹 검색이 이 잡의 존재 이유이므로 비우지 마세요
# (비우면 도구를 끄고 모델 기억만으로 요약합니다 — 경고가 출력됩니다).
CLAUDE_CLI_ALLOWED_TOOLS=WebSearch,WebFetch


# ==========================================
# Gemini CLI (요약 백엔드 — 비교용)
# ==========================================
# batch/url_briefing_gemini.py 전용 스위치. CLAUDE_CLI_ENABLED 와 별개라 함께 켜도 됩니다.
#   1/true/yes/on → 켜짐, 그 외/미설정 → 꺼짐
GEMINI_CLI_ENABLED=0

# 사용할 모델. 전체 이름 권장(gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite).
# 별칭(pro/flash/flash-lite)은 실행 시 전체 이름으로 펴집니다. 비우면 CLI 기본값.
GEMINI_CLI_MODEL=gemini-2.5-pro

# 요약 하나당 제한 시간(초). 기본 300. gemini 에는 effort 에 해당하는 설정이 없습니다.
GEMINI_CLI_TIMEOUT=300

# 허용할 도구. **web_fetch 를 빠뜨리지 마세요** — gemini 는 비대화형 실행에서 승인이
# 필요한 도구를 목록에서 아예 빼기 때문에, 오류 없이 모델 기억으로 쓴 보고서가 나옵니다.
GEMINI_CLI_ALLOWED_TOOLS=google_web_search,web_fetch

# gemini 인증 키 (https://aistudio.google.com/apikey).
# 계정 로그인(oauth-personal)이 IneligibleTierError 로 거부될 때 씁니다. 키만으로는
# 부족하고 ~/.gemini/settings.json 의 security.auth.selectedType 도 함께 고쳐야 합니다:
#   "security": { "auth": { "selectedType": "gemini-api-key" } }
# 터미널에서 gemini 가 그냥 되는 상태라면 비워 두세요.
GEMINI_API_KEY=


# ==========================================
# 정기 요약 (batch/daily_briefing.py)
# ==========================================
# 요약할 주제 목록(쉼표 구분). 주제 하나당 claude 호출이 한 번 나갑니다.
# **주제 하나를 전제로 분량이 맞춰져 있어** 2개 이상이면 Discord 메시지가 잘립니다
# (파일에는 온전히 남고 실행 로그에 경고가 뜹니다). 주제별 알림을 원하면 cron 줄을 나누세요.
BRIEFING_TOPICS=AI 업계 주요 소식

# 결과가 쌓이는 뿌리 디렉터리 (기본: batch/output). 모든 잡이 함께 쓰고, 그 아래
# 잡 이름 디렉터리가 생깁니다. 상대경로는 cwd 기준이니 batch/run.sh 를 쓰세요.
BRIEFING_OUTPUT_DIR=


# ==========================================
# URL 브리핑 (batch/url_briefing.py, url_briefing_gemini.py)
# ==========================================
# 훑어서 요약할 커뮤니티 사이트 주소. **딱 하나만** 넣고, http:// 또는 https:// 로
# 시작해야 합니다(스킴이 없으면 실행 즉시 오류). 여러 곳은 cron 줄을 나누세요:
#   0 7 * * * URL_BRIEFING_URL=https://a.example /path/batch/run.sh url_briefing
URL_BRIEFING_URL=

# 보고서 머리말의 대상 링크에 표시할 이름. 비우면 호스트명을 씁니다.
#   > 대상: [__"클리앙 모두의공원"__](<https://www.clien.net/service/board/park>)
URL_BRIEFING_NAME=


# ==========================================
# Discord 알림 (batch/discord_notify.py)
# ==========================================
# 배치 결과를 채널에 **메시지 본문**으로 보냅니다(첨부파일 아님).
# 웹훅 만들기: 채널 설정 → 연동 → 웹훅 → 새 웹훅 → URL 복사.
# 이 URL 자체가 인증 수단이니 공유하지 마세요. 비우면 전송을 건너뜁니다.
DISCORD_WEBHOOK_URL=

# 메시지에 표시할 이름. 여러 잡이 같은 채널을 쓸 때 구분용. 비우면 웹훅 설정값.
DISCORD_USERNAME=

# 전송 제한 시간(초). 기본 15.
DISCORD_TIMEOUT=
