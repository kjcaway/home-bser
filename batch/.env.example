# ==========================================
# 배치 잡 전용 설정 (batch/*.py)
# ==========================================
# 이 파일을 batch/.env 로 복사한 뒤 값을 채우세요. batch/.env 는 git 에 올라가지 않습니다.
#   cp batch/.env.example batch/.env
#
# 프로젝트 루트의 .env 와 **완전히 별개**입니다. 배치 잡은 batch/config.py 의
# load_batch_env() 로 이 파일만 읽으므로, 루트 .env 값은 배치에 영향을 주지 않습니다.
# 같은 키 이름을 쓰지만 값은 목적에 맞게 다르게 잡습니다 (음성은 지연이 체감되니 짧게,
# 배치는 사람이 기다리지 않으니 길게).
#
# 실제 환경변수가 이 파일보다 항상 우선이므로 일회성 덮어쓰기도 가능합니다:
#   CLAUDE_CLI_EFFORT=low ./batch/run.sh


# ==========================================
# Claude Code CLI (요약 백엔드)
# ==========================================
# 배치 요약은 claude CLI 전용입니다. 꺼져 있으면 잡이 아무것도 하지 않고 종료 코드 1 로
# 끝납니다 (hermes 폴백은 없습니다 — 웹 검색이 이 잡의 목적이라 로컬 모델로는 대체가
# 되지 않습니다).
#   1/true/yes/on → 켜짐, 그 외/미설정 → 꺼짐
CLAUDE_CLI_ENABLED=1

# 사용할 모델. 전체 이름 권장(claude-opus-5, claude-sonnet-5, claude-haiku-4-5,
# claude-fable-5). 별칭(opus/sonnet/haiku/fable)도 받지만 별칭은 "그 계열의 최신
# 모델"이라 CLI 버전이 오르면 조용히 바뀌므로, 아는 별칭은 실행 시 전체 이름으로
# 펴서 넘깁니다. 비우면 CLI 기본값.
CLAUDE_CLI_MODEL=claude-sonnet-5

# 생각 깊이(--effort): low / medium / high / xhigh / max.
# 음성과 달리 지연이 체감되지 않으므로 품질 쪽으로 올려도 됩니다.
CLAUDE_CLI_EFFORT=high

# 주제 하나당 제한 시간(초). 기본 300 — 웹 검색을 여러 번 도는 것이 정상입니다.
# 초과한 주제는 실패로 기록되고 나머지 주제는 계속 진행됩니다.
CLAUDE_CLI_TIMEOUT=300

# 허용할 도구. 웹 검색이 이 잡의 존재 이유이므로 비우지 마세요.
# 비우면 --tools "" 로 도구를 끄고 모델 기억만으로 요약합니다(경고가 출력됩니다).
CLAUDE_CLI_ALLOWED_TOOLS=WebSearch,WebFetch


# ==========================================
# 정기 요약 (batch/daily_briefing.py)
# ==========================================
# 요약할 주제 목록. **쉼표로 구분**하며, 주제 하나당 claude 호출이 한 번 나갑니다.
#
# **주제 하나를 전제로 맞춰져 있습니다.** 요약 프롬프트의 분량(항목 6개 × 200자)이
# Discord 본문 상한 2000자를 주제 하나가 다 쓴다고 보고 역산한 값이라, 주제를 2개
# 이상 넣으면 메시지가 잘립니다(파일에는 온전히 남고, 실행 로그에 경고가 뜹니다).
# 주제를 늘리려면 batch/claude_query.py 의 SYSTEM_PROMPT 분량도 주제 수로 나눠
# 다시 잡으세요 (예: 주제 5개면 항목 3개 × 100자).
BRIEFING_TOPICS=AI 업계 주요 소식

# 결과가 쌓이는 뿌리 디렉터리 (기본: batch/output). **모든 배치 잡이 함께 씁니다.**
# 그 아래 잡 이름 디렉터리가 생기고, 파일명은 실행 시각입니다
# (daily_briefing/YYYY-MM-DD-HH.md / url_briefing/YYYY-MM-DD-HH.md).
# 같은 시간대에 재실행하면 덮어쓰고, 다른 시각의 실행은 파일이 따로 쌓입니다.
# 상대경로는 실행 시 cwd 기준이므로, 저장소 루트에서 실행하거나 batch/run.sh 를 쓰세요.
BRIEFING_OUTPUT_DIR=


# ==========================================
# URL 브리핑 (batch/url_briefing.py)
# ==========================================
# 훑어서 요약할 커뮤니티 사이트 주소. **딱 하나만** 넣습니다 (쉼표로 여러 개를 넣어도
# 하나의 주소로 취급되어 실패합니다).
#
# http:// 또는 https:// 로 시작해야 합니다. 스킴을 빼면 실행 즉시 오류로 끝나는데,
# 그대로 넘기면 모델이 페이지를 여는 대신 웹 검색으로 비슷한 곳을 찾아 그럴듯한 보고서를
# 써 오기 때문입니다 — 실패보다 '엉뚱한 성공'이 알아채기 어렵습니다.
#
# 여러 곳을 훑고 싶다면 값을 늘리는 대신 cron 줄을 나누세요:
#   0 7 * * * URL_BRIEFING_URL=https://a.example ... /path/batch/run.sh url_briefing
# 요약 분량(개요 150자 + 항목 6개 × 180자)이 Discord 본문 2000자를 보고서 하나가 다
# 쓴다고 보고 역산한 값이라, 한 문서에 여러 사이트를 담으면 뒤쪽이 잘립니다.
#
# 위의 CLAUDE_CLI_ALLOWED_TOOLS 에 WebFetch 가 반드시 있어야 합니다. 없으면 페이지를
# 열지 못해 모델의 기억으로 쓴 보고서가 나옵니다(실행 시 경고가 출력됩니다).
URL_BRIEFING_URL=

# 보고서 머리말의 대상 링크에 표시할 이름입니다. 긴 주소를 그대로 보여주지 않고
# 이 이름에 밑줄+링크를 걸어 표시합니다:
#   > 대상: [__"클리앙 모두의공원"__](<https://www.clien.net/service/board/park>)
#
# 모델에게 물어보지 않고 여기서 받는 이유는, 사이트 이름이 실행마다 달라질 값이 아니기
# 때문입니다 — 모델이 읽게 하면 매번 지어낼 여지가 생기고 페이지를 못 열면 빈 값이 됩니다.
#
# 비워 두면 주소의 호스트명(www.clien.net)을 대신 씁니다. 대괄호 [ ] 는 링크 문법을
# 깨뜨리므로 자동으로 제거됩니다.
URL_BRIEFING_NAME=


# ==========================================
# Discord 알림 (batch/discord_notify.py)
# ==========================================
# 배치 결과를 Discord 채널에 **메시지 본문**으로 보냅니다(첨부파일 아님).
# 웹훅 만들기: 채널 설정 → 연동 → 웹훅 → 새 웹훅 → 웹훅 URL 복사.
#
# 이 URL 자체가 인증 수단입니다 — 아는 사람은 누구나 그 채널에 글을 쓸 수 있으니
# 공유하지 마세요(batch/.env 는 git 에 올라가지 않습니다). 값을 비우면 전송을 건너뜁니다.
DISCORD_WEBHOOK_URL=

# 메시지에 표시할 이름. 비우면 웹훅에 설정된 이름을 씁니다. 여러 잡이 같은 채널을 쓸 때
# 어느 잡이 보낸 알림인지 구분하는 용도입니다.
DISCORD_USERNAME=

# 전송 제한 시간(초). 기본 15.
DISCORD_TIMEOUT=
